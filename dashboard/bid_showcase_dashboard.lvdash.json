{
  "datasets": [
    {
      "name": "match_rate_comparison",
      "displayName": "Match Rate Comparison (illustrative \u2014 legacy/CAT per BRD; Databricks AI is this showcase's target)",
      "queryLines": [
        "SELECT 'Legacy tool' AS approach, 5.0 AS match_rate_pct, 1 AS sort_order UNION ALL SELECT 'CAT tool (code given only)', 50.0, 2 UNION ALL SELECT 'Databricks AI (this showcase)', 90.0, 3"
      ]
    },
    {
      "name": "prep_time_trend",
      "displayName": "Proposal Prep Time Trend (illustrative \u2014 toward the BRD's <3hr target)",
      "queryLines": [
        "SELECT 'Week 1' AS week_label, 8.0 AS avg_prep_hours, 1 AS sort_order UNION ALL SELECT 'Week 2', 6.8, 2 UNION ALL SELECT 'Week 3', 5.4, 3 UNION ALL SELECT 'Week 4', 4.2, 4 UNION ALL SELECT 'Week 5', 3.3, 5 UNION ALL SELECT 'Week 6', 2.7, 6"
      ]
    },
    {
      "name": "on_time_trend",
      "displayName": "On-Time Submission Rate Trend (illustrative \u2014 toward the BRD's 95% target)",
      "queryLines": [
        "SELECT 'Week 1' AS week_label, 61.0 AS on_time_pct, 1 AS sort_order UNION ALL SELECT 'Week 2', 70.0, 2 UNION ALL SELECT 'Week 3', 78.0, 3 UNION ALL SELECT 'Week 4', 85.0, 4 UNION ALL SELECT 'Week 5', 91.0, 5 UNION ALL SELECT 'Week 6', 96.0, 6"
      ]
    },
    {
      "name": "bid_outcomes_by_division",
      "displayName": "Historical Bid Outcomes by Division",
      "queryLines": [
        "SELECT d.division_name, d.capacity_constrained, hb.outcome, hb.historical_bid_id FROM `pavan_naidu`.`bids_ai_demo_dev`.historical_bids hb JOIN `pavan_naidu`.`bids_ai_demo_dev`.divisions d ON hb.division_id = d.division_id"
      ]
    },
    {
      "name": "price_by_category",
      "displayName": "Avg Submitted vs. List Price by Category",
      "queryLines": [
        "SELECT ic.category, 'Submitted price' AS metric, AVG(hb.submitted_price) AS avg_price FROM `pavan_naidu`.`bids_ai_demo_dev`.historical_bids hb JOIN `pavan_naidu`.`bids_ai_demo_dev`.item_catalog ic ON hb.item_code = ic.item_code GROUP BY ic.category UNION ALL SELECT ic.category, 'List price' AS metric, AVG(ic.list_price) AS avg_price FROM `pavan_naidu`.`bids_ai_demo_dev`.historical_bids hb JOIN `pavan_naidu`.`bids_ai_demo_dev`.item_catalog ic ON hb.item_code = ic.item_code GROUP BY ic.category"
      ]
    }
  ],
